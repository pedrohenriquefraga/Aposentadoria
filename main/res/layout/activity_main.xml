<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/background_gradient"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/fonte"
        android:gravity="center"
        android:text="@string/txt_titulo_app"
        android:textColor="@color/white"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="25dp"
        android:fontFamily="@font/fonte"
        android:gravity="center"
        android:text="@string/txt_subtitulo_app"
        android:textColor="@color/white"
        android:textSize="21sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutIdade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_campo_idade"
        app:counterEnabled="true"
        app:counterMaxLength="3"
        app:endIconMode="clear_text"
        app:helperText="@string/helper_campo_obrigatorio"
        app:helperTextTextColor="@color/accent_cyan"
        app:startIconDrawable="@android:drawable/ic_menu_my_calendar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtIdade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fonte"
            android:inputType="number"
            android:maxLength="3" />

    </com.google.android.material.textfield.TextInputLayout>

    <Spinner
        android:id="@+id/spinnerGenero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="10dp" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/blue_dark"
        android:fontFamily="@font/fonte"
        android:padding="12dp"
        android:text="@string/btn_calcular_aposentadoria"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnLimpar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:fontFamily="@font/fonte"
        android:text="@string/btn_limpar_campos"
        android:textColor="@color/blue_dark"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:fontFamily="@font/fonte"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/txt_resultado_padrao"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/fonte"
        android:gravity="center"
        android:text="@string/txt_nome_aluno"
        android:textColor="@color/accent_cyan"
        android:textSize="30sp" />

</LinearLayout>